{
  "name": "blu3-server",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target node --minify --entry-naming index.js",
    "start": "bun run ./dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "@hono/node-ws": "^1.3.1",
    "@neondatabase/serverless": "^1.1.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.21",
    "nanoid": "^5.1.11",
    "play-dl": "^1.9.7",
    "postgres": "^3.4.9",
    "ws": "^8.21.0",
    "ytmusic-api": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}
