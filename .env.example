# ── Required ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
BETTER_AUTH_URL="http://localhost:8000"
BETTER_AUTH_SECRET="generate-a-long-random-secret"
FRONTEND_URL="http://localhost:3000"

# ── OAuth providers (at least one recommended) ──────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_SECRET=""

# ── Rate limiting (optional — skips if absent, fails open) ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Spotify playlist import (optional) ─────────────────────
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# ── YouTube Music fallback (optional) ───────────────────────
YOUTUBE_API_KEY=""
YTMUSIC_API_KEY=""
YTMUSIC_CLIENT_VERSION="1.20250204.01.00"

# ── YouTube audio extraction (optional, restricted envs) ────
YT_COOKIES=""
YT_COOKIES_FILE="./cookies.json"

# ── Extra CORS origins (optional) ───────────────────────────
CORS_ORIGINS="http://localhost:3000,https://blu3.in"

# ── Server ─────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
